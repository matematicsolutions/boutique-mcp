    "boutique_request_coverage": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "description": "Draft a coverage-request issue for a gap in the Boutique catalog.\n\nDRAFT ONLY - this tool performs no network call and submits nothing.\nA human reviews the draft and submits it at the returned URL.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "description": "what is missing and for what task (plain language).",
              "type": "string"
            },
            "jurisdiction": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "optional jurisdiction the gap concerns."
            }
          },
          "required": [
            "description"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "boutique_request_coverage",
        "outputSchema": {
          "description": "A DRAFT coverage request. Nothing is sent anywhere - a human submits it.",
          "properties": {
            "body": {
              "type": "string"
            },
            "disclaimer": {
              "type": "string"
            },
            "submit_url": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "body",
            "submit_url",
            "disclaimer"
          ],
          "type": "object"
        }
      },
      "sha256": "8eec94befb7bae8e6cce0af97289ce9a5169780692d05f50cb5669f63149d4f7"
    },
    "boutique_search": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Search the MateMatic Boutique catalog for connectors and skills.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "entry_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "optional filter: \"konektor\" (MCP connector), \"skill\"\n(MateMatic skill) or \"kuratorski\" (curated third-party skill)."
            },
            "jurisdiction": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "optional filter, matched against the entry's jurisdiction\nlabel (e.g. \"Polska\", \"EU\", \"Brasil\")."
            },
            "limit": {
              "default": 10,
              "description": "max hits (1-25, default 10).",
              "type": "integer"
            },
            "query": {
              "description": "keywords in English, Polish or Portuguese (e.g. \"case law Poland\",\n\"anonimizacja\", \"German law\").",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "boutique_search",
        "outputSchema": {
          "properties": {
            "gaps": {
              "items": {
                "description": "Explicit statement of what the catalog does NOT cover for this query.",
                "properties": {
                  "detail": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "no_match",
                      "jurisdiction_uncovered",
                      "type_uncovered"
                    ],
                    "type": "string"
                  },
                  "suggestion": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "detail",
                  "suggestion"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "hits": {
              "items": {
                "properties": {
                  "card_url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "category": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "description": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "id": {
                    "type": "string"
                  },
                  "install": {
                    "additionalProperties": true,
                    "description": "How to install a catalog entry LOCALLY. The catalog never proxies anything.",
                    "properties": {
                      "command": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Copy-paste local install command"
                      },
                      "kind": {
                        "description": "uvx | npx | download | github",
                        "type": "string"
                      },
                      "url": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Download or repository URL"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "type": "object"
                  },
                  "jurisdiction": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "license": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "name": {
                    "type": "string"
                  },
                  "score": {
                    "type": "number"
                  },
                  "type": {
                    "enum": [
                      "konektor",
                      "skill",
                      "kuratorski"
                    ],
                    "type": "string"
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "required": [
                  "id",
                  "type",
                  "name",
                  "install",
                  "score"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "provenance": {
              "description": "Where the catalog data in this response came from, and how old it is.",
              "properties": {
                "catalog_generated_at": {
                  "type": "string"
                },
                "fetched_at": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "note": {
                  "type": "string"
                },
                "origin": {
                  "enum": [
                    "network",
                    "disk-cache",
                    "bundled-snapshot"
                  ],
                  "type": "string"
                },
                "stale": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "origin",
                "catalog_generated_at",
                "note"
              ],
              "type": "object"
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query",
            "provenance"
          ],
          "type": "object"
        }
      },
      "sha256": "0340f60b302d1b8ef2bab76d74f38610c4ba84b7f12ed0fa7097cea94aa126a6"
