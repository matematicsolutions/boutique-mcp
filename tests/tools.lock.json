          "properties": {
            "id": {
              "description": "the entry id from boutique_search (e.g. \"mcp-saos\", \"de-eli-mcp\",\n\"humanizer-pl\").",
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "boutique_get",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
